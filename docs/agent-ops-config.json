{
  "schema_version": 1,
  "project": "WorklazyTools",
  "policy_version": "2026-11-12",
  "models": {
    "gemini": "gemini-4-argon-high",
    "gemini_on_quota_exceeded": "gemini-3.8-flash-high",
    "implementation": "muse-spark-1.3-contributor",
    "implementation_fallback": "gpt-6.1-sol",
    "review": "gpt-6.1-sol",
    "research": "gpt-6.1-terra",
    "terra": "gpt-6.1-terra",
    "muse_runtime_id": "opencode-go/muse-spark-1.3-contributor",
    "review_alt_for_sol_implementation": "claude-sonnet-5-5",
    "plan_review": "gpt-6-astra",
    "escalation_review": "gpt-6-astra"
  },
  "review": {
    "max_tasks": 5,
    "max_lines": 800,
    "elapsed_time_trigger": false
