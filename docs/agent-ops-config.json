{
  "schema_version": 1,
  "project": "WorklazyTools",
  "policy_version": "2026-10-30",
  "models": {
    "gemini": "gemini-4-argon-high",
    "implementation": "muse-spark-1.3-contributor",
    "implementation_fallback": "gpt-6.1-sol",
    "review": "gpt-6-astra",
    "research": "gpt-6.1-luna",
    "terra": "gpt-6.1-terra",
    "muse_runtime_id": "opencode-go/muse-spark-1.3-contributor"
  },
  "review": {
    "max_tasks": 5,
    "max_lines": 800,
    "elapsed_time_trigger": false
  },
  "line_count_exclude_globs": [
    "dist/**",
    "vendor/**",
    "public/vendor/**",
    "**/vendor/**"
  ],
  "high_risk_paths": [
    {
      "glob": "AGENTS.md",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "CLAUDE.md",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "GEMINI.md",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "PROJECT_RULES.md",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "docs/agent-ops-config.json",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "docs/agent-dispatch-runbook.md",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "scripts/agent_ops.py",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "scripts/codex_direct.py",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "scripts/secret_scan.py",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "scripts/gemini_research.py",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "**/*scoped-verification/**",
      "reason": "agent_authority_or_review_control"
    },
    {
      "glob": "src/**/crypto*",
      "reason": "sensitive_data"
    },
    {
      "glob": "src/**/encrypt*",
      "reason": "sensitive_data"
    },
    {
      "glob": "src/**/serialize*",
      "reason": "output_contract"
    },
    {
      "glob": "src/**/shared/**",
      "reason": "shared_contract"
    },
    {
      "glob": "package.json",
      "reason": "dependencies_or_build"
    },
    {
      "glob": "package-lock.json",
      "reason": "dependencies_or_build"
    }
  ]
}
