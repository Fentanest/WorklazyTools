+import { describe, expect, it } from 'vitest';
+import { hasCanvasTransparency } from './alpha';
+function surface(width: number, height: number, alphaAt: (x: number, y: number) => number) {
+  const reads: number[][] = [];
+  return { reads, canvas: { width, height, getContext: () => ({ getImageData(x: number, y: number, w: number, h: number) {
+    reads.push([x, y, w, h]); const data = new Uint8ClampedArray(w * h * 4);
+    for (let row = 0; row < h; row++) for (let col = 0; col < w; col++) data[(row * w + col) * 4 + 3] = alphaAt(x + col, y + row);
+    return { data };
+  } }) } as unknown as HTMLCanvasElement };
+}
+describe('actual output alpha', () => {
+  it('does not confuse black RGB pixels with transparency', () => {
+    const { canvas } = surface(2, 2, () => 255); expect(hasCanvasTransparency(canvas)).toBe(false);
+  });
+  it('detects partial transparency, not only fully erased pixels', () => {
+    const { canvas } = surface(2, 2, (x, y) => x === 1 && y === 1 ? 254 : 255); expect(hasCanvasTransparency(canvas)).toBe(true);
+  });
+  it('finds alpha in the last row while bounding every readback', () => {
+    const { canvas, reads } = surface(3, 129, (_, y) => y === 128 ? 0 : 255);
+    expect(hasCanvasTransparency(canvas)).toBe(true); expect(reads.at(-1)).toEqual([0, 128, 3, 1]);
+    expect(reads.every(([, , , height]) => height <= 64)).toBe(true);
+  });
+  it('accepts an empty surface without allocating readback', () => {
+    const { canvas, reads } = surface(0, 0, () => 0); expect(hasCanvasTransparency(canvas)).toBe(false); expect(reads).toEqual([]);
+  });
+});
diff --git a/packages/react-image-editor/src/engine/alpha.ts b/packages/react-image-editor/src/engine/alpha.ts
--- a/packages/react-image-editor/src/engine/alpha.ts
+++ b/packages/react-image-editor/src/engine/alpha.ts
@@ -0,0 +1,11 @@
+/** Inspect the actual output surface, with bounded readback instead of a second full RGBA buffer. */
+export function hasCanvasTransparency(canvas: Pick<HTMLCanvasElement, 'width' | 'height' | 'getContext'>): boolean {
+  if (!canvas.width || !canvas.height) return false;
+  const context = canvas.getContext('2d');
+  if (!context) throw new Error('Could not read image transparency.');
+  for (let y = 0; y < canvas.height; y += 64) {
+    const pixels = context.getImageData(0, y, canvas.width, Math.min(64, canvas.height - y)).data;
+    for (let i = 3; i < pixels.length; i += 4) if (pixels[i] < 255) return true;
+  }
+  return false;
+}
