{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional saved KRX article excerpts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bookid",
          "title",
          "fetched_at",
          "raw_sha256",
          "text_sha256",
          "representation",
          "excerpts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^krx-(rule|enforcement-[a-z]+)-[0-9]+$"
          },
          "bookid": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "representation": {
            "enum": [
              "original",
              "session_redacted"
            ]
          },
          "excerpts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "article",
                "text"
              ],
              "properties": {
                "article": {
                  "type": "string",
                  "pattern": "^제[0-9]+조",
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              }
            }
          }
        }
      }
    }
  }
}
